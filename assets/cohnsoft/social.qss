/* Original Cohnsoft native controls; application and credential IDs are unchanged. */
QWidget{font-family:"Cohn Sans";color:#1d1d1f}QMainWindow,QWidget#appShell,QWidget#main{background:#f2f2f7}QWidget#sidebar{background:#f2f2f7;border-right:1px solid #d8d8dc}QMenuBar,QWidget#threadChrome{background:#fff;color:#1d1d1f;border-color:#d8d8dc}QMenu{background:#fff;color:#1d1d1f;border:1px solid #d8d8dc}
QMenuBar::item:selected,QMenu::item:selected,QPushButton#nav[selected="true"],QPushButton#chip{background:#edf6ef;color:#0a7a37;border-color:#d1e8d9}QWidget#card,QWidget#composeCard,QWidget#sectionCard{background:#fff;border:1px solid #d8d8dc;border-radius:12px}QPushButton{background:#f2f2f7;border:1px solid #d8d8dc;border-radius:9px;color:#1d1d1f}QPushButton#primary{background:#0a7a37;color:#fff;border-color:#0a7a37}QPushButton#primary:hover{background:#08632d}QPushButton:focus,QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus{border:2px solid #0a7a37}QLineEdit,QTextEdit,QPlainTextEdit,QComboBox{background:#fff;color:#1d1d1f;border-color:#d8d8dc;selection-background-color:#d1e8d9;selection-color:#1d1d1f}QCheckBox::indicator:checked{background:#0a7a37;border-color:#0a7a37}QLabel#muted,QLabel#eyebrow,QPushButton#postAction,QPushButton#textLink{color:#636366}QLabel#postText{color:#1d1d1f}QToolTip{background:#fff;color:#1d1d1f;border:1px solid #d8d8dc}

QWidget#hero{background:#fff;border-color:#d8d8dc}QWidget#hero QLabel{color:#1d1d1f}QWidget#hero QLabel#eyebrow{color:#0a7a37}QPushButton#feedTab[selected="true"]{border-bottom:2px solid #0a7a37;color:#1d1d1f}
